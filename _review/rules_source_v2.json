{
 "version": "V2",
 "rules": [
  {
   "rule_id": "GW-HB-FJ-001",
   "row": 1,
   "category": "形式评审",
   "subcategory": "格式内容",
   "rule_text": "投标文件未按招标文件规定的格式填写，内容不全或者关键字迹模糊无法辨认的。未按招标文件要求在招标人招投标交易平台信息系统制作并上传凭证单，或因投标人删除了系统文件导致凭证单索引的核实信息无法查看的。",
   "exec_path": "EXTRACT_DET",
   "needs": [
    "bid.voucher_index_viewable",
    "bid.format_completeness"
   ],
   "check": {
    "op": "and",
    "args": [
     {
      "op": "eq",
      "lhs": "bid.voucher_index_viewable",
      "rhs": true
     },
     {
      "op": "eq",
      "lhs": "bid.format_completeness",
      "rhs": "complete"
     }
    ]
   },
   "evidence": "招投标交易平台凭证单 / 投标文件各分册首页",
   "human_gate": null,
   "external_source": null,
   "signals": null,
   "conclusion_ceiling": "CANDIDATE",
   "states": {
    "pass": "RESPONDED",
    "fail": "NOT_RESPONDED",
    "missing": "UNCERTAIN"
   }
  },
  {
   "rule_id": "GW-HB-FJ-002",
   "row": 2,
   "category": "形式评审",
   "subcategory": "格式内容",
   "rule_text": "投标人递交两份或多份内容不同的投标文件，或在一份投标文件中对同一招标内容报有两个或多个报价，按招标文件规定提交备选投标方案的除外。",
   "exec_path": "DET",
   "needs": [
    "bid.file_count_with_diff_content",
    "bid.distinct_price_count",
    "bid.alternative_declared"
   ],
   "check": {
    "op": "and",
    "args": [
     {
      "op": "le",
      "lhs": "bid.file_count_with_diff_content",
      "rhs": 1
     },
     {
      "op": "or",
      "args": [
       {
        "op": "le",
        "lhs": "bid.distinct_price_count",
        "rhs": 1
       },
       {
        "op": "eq",
        "lhs": "bid.alternative_declared",
        "rhs": true
       }
      ]
     }
    ]
   },
   "evidence": "投标文件封面/目录、开标一览表、投标函",
   "human_gate": null,
   "external_source": null,
   "signals": null,
   "conclusion_ceiling": "CANDIDATE",
   "states": {
    "pass": "RESPONDED",
    "fail": "NOT_RESPONDED",
    "missing": "UNCERTAIN"
   }
  },
  {
   "rule_id": "GW-HB-FJ-003",
   "row": 3,
   "category": "形式评审",
   "subcategory": "文件签署",
   "rule_text": "对格式文件进行实质性修改或未按格式进行签署的，如由委托代理人签字的，未附有效的法定代表人（单位负责人）授权委托书的（未提交法定代表人（单位负责人）授权委托书，或法定代表人（单位负责人）授权委托书未经投标单位盖章或法定代表人（单位负责人）签名（或签章）的）；使用投标专用章未附有效的投标专用章与公章具有同等效力说明的。",
   "exec_path": "EXTRACT_DET",
   "needs": [
    "bid.authorization_letter_present",
    "bid.authorization_letter_elements_ok",
    "bid.legal_rep_seal_present"
   ],
   "check": {
    "op": "and",
    "args": [
     {
      "op": "eq",
      "lhs": "bid.authorization_letter_present",
      "rhs": true
     },
     {
      "op": "eq",
      "lhs": "bid.authorization_letter_elements_ok",
      "rhs": true
     },
     {
      "op": "eq",
      "lhs": "bid.legal_rep_seal_present",
      "rhs": true
     }
    ]
   },
   "evidence": "法定代表人授权委托书 / 格式文件签署页",
   "human_gate": "对格式文件是否构成实质性修改，由评标委员会认定",
   "external_source": null,
   "signals": null,
   "conclusion_ceiling": "CANDIDATE",
   "states": {
    "pass": "RESPONDED",
    "fail": "NOT_RESPONDED",
    "missing": "UNCERTAIN"
   }
  },
  {
   "rule_id": "GW-HB-FJ-004",
   "row": 4,
   "category": "形式评审",
   "subcategory": "文件签署",
   "rule_text": "上传招标人招投标交易平台信息系统的电子投标文件无电子签章，或者电子签章无效的，或者电子签章名称与投标人不是同一人的。",
   "exec_path": "DET",
   "needs": [
    "bid.seal_present",
    "bid.seal_valid",
    "bid.seal_name"
   ],
   "check": {
    "op": "and",
    "args": [
     {
      "op": "eq",
      "lhs": "bid.seal_present",
      "rhs": true
     },
     {
      "op": "eq",
      "lhs": "bid.seal_valid",
      "rhs": true
     },
     {
      "op": "eq",
      "lhs": "normalize(bid.seal_name)",
      "rhs": "normalize(bid.bidder_name)"
     }
    ]
   },
   "evidence": "电子投标文件签章页",
   "human_gate": null,
   "external_source": null,
   "signals": null,
   "conclusion_ceiling": "CANDIDATE",
   "states": {
    "pass": "RESPONDED",
    "fail": "NOT_RESPONDED",
    "missing": "UNCERTAIN"
   }
  },
  {
   "rule_id": "GW-HB-FJ-005",
   "row": 5,
   "category": "响应性评审",
   "subcategory": "澄清修改",
   "rule_text": "提交投标文件截止时间后主动撤销投标文件或对投标文件提出实质性修改的。",
   "exec_path": "DET",
   "needs": [
    "bid.withdrawn_after_deadline"
   ],
   "check": {
    "op": "eq",
    "lhs": "bid.withdrawn_after_deadline",
    "rhs": false
   },
   "evidence": "招投标交易平台操作日志",
   "human_gate": null,
   "external_source": null,
   "signals": null,
   "conclusion_ceiling": "CANDIDATE",
   "states": {
    "pass": "RESPONDED",
    "fail": "NOT_RESPONDED",
    "missing": "UNCERTAIN"
   }
  },
  {
   "rule_id": "GW-HB-FJ-006",
   "row": 6,
   "category": "响应性评审",
   "subcategory": "澄清修改",
   "rule_text": "不按评标委员会要求对投标文件进行澄清、说明或补正的。",
   "exec_path": "HUMAN",
   "needs": [],
   "check": null,
   "evidence": "评标委员会澄清通知 / 投标人澄清回函",
   "human_gate": "澄清是否已被要求、是否回应，由评标委员会记录",
   "external_source": null,
   "signals": null,
   "conclusion_ceiling": "NEED_HUMAN",
   "states": {
    "always": "NEED_HUMAN"
   }
  },
  {
   "rule_id": "GW-HB-FJ-007",
   "row": 7,
   "category": "响应性评审",
   "subcategory": "交付期限",
   "rule_text": "投标文件所承诺的交货期不满足招标文件要求的，且招标人不能接受的。",
   "exec_path": "EXTRACT_DET",
   "needs": [
    "bid.committed_delivery_date",
    "tender.required_delivery_date"
   ],
   "check": {
    "op": "le",
    "lhs": "bid.committed_delivery_date",
    "rhs": "tender.required_delivery_date"
   },
   "evidence": "投标函 / 商务偏差表",
   "human_gate": "交货期不满足时，是否接受由招标人决定，系统只报「不满足」",
   "external_source": null,
   "signals": null,
   "conclusion_ceiling": "CANDIDATE",
   "states": {
    "pass": "RESPONDED",
    "fail": "NOT_RESPONDED",
    "missing": "UNCERTAIN"
   }
  },
  {
   "rule_id": "GW-HB-FJ-008",
   "row": 8,
   "category": "响应性评审",
   "subcategory": "投标报价",
   "rule_text": "投标人不接受评标委员会依法所作的修正价格的。",
   "exec_path": "HUMAN",
   "needs": [],
   "check": null,
   "evidence": "评标委员会价格修正记录 / 投标人确认",
   "human_gate": "接受与否由评标委员会现场确认",
   "external_source": null,
   "signals": null,
   "conclusion_ceiling": "NEED_HUMAN",
   "states": {
    "always": "NEED_HUMAN"
   }
  },
  {
   "rule_id": "GW-HB-FJ-009",
   "row": 9,
   "category": "响应性评审",
   "subcategory": "投标报价",
   "rule_text": "报价明显低于其他投标报价，且投标人不能合理说明或者提供相关证明材料，评标委员会认定该投标人以低于成本报价竞标的。",
   "exec_path": "HUMAN",
   "needs": [
    "bid.price_total",
    "peer.price_avg"
   ],
   "check": null,
   "evidence": "开标一览表 / 报价说明 / 成本证明材料",
   "human_gate": "是否低于成本由评标委员会认定",
   "external_source": null,
   "signals": [
    "bid.price_total / peer.price_avg >= 0.8 时不提示",
    "0.5~0.8 提示「显著偏低，建议要求说明」",
    "<0.5 提示「严重偏离，建议重点核查」"
   ],
   "conclusion_ceiling": "NEED_HUMAN",
   "states": {
    "always": "NEED_HUMAN"
   }
  },
  {
   "rule_id": "GW-HB-FJ-010",
   "row": 10,
   "category": "响应性评审",
   "subcategory": "投标报价",
   "rule_text": "招标文件中明确规定了最高限价（包括具体金额、计算方式），投标人的投标价格剔除角和分（单价限价不剔除）的数值后超过最高限价的。",
   "exec_path": "DET",
   "needs": [
    "tender.price_cap_items"
   ],
   "check": {
    "op": "per_item_within_cap",
    "lhs": "bid.price_items",
    "rhs": "tender.price_cap_items",
    "fallback_total": "floor_yuan(bid.price_total_ex_tax)",
    "key": "item_no",
    "amount_basis": "tax_incl",
    "amount_basis_why": "限价表（附表一）为含税限价，投标分项报价表为未含税合价；不同口径直接比会把含税超限的行判成合规（宜昌行含税 460 万 > 限价 453.31 万，未含税仅 407.08 万）。按行10 原文「剔除角和分」向下取整到元。"
   },
   "optional_needs": [
    "bid.price_items",
    "bid.price_total_ex_tax",
    "tender.price_cap_applicable"
   ],
   "evidence": "开标一览表 / 投标函价格表 / 招标文件最高限价条款",
   "human_gate": null,
   "external_source": null,
   "signals": null,
   "conclusion_ceiling": "CANDIDATE",
   "states": {
    "pass": "RESPONDED",
    "fail": "NOT_RESPONDED",
    "missing": "UNCERTAIN"
   }
  },
  {
   "rule_id": "GW-HB-FJ-011",
   "row": 11,
   "category": "响应性评审",
   "subcategory": "投标报价",
   "rule_text": "投标报价构成招标文件规定为无效报价的；开标一览表中显示为非报价数值的。投标报价小数点错误导致单价总价都出现明显错误的。",
   "exec_path": "DET",
   "needs": [
    "bid.price_items"
   ],
   "check": {
    "op": "per_item_amount_check",
    "lhs": "bid.price_items",
    "tolerance_yuan": 0.5,
    "tolerance_why": "合价列在文件里带两位小数，表格化/抽取时常取整到元（7,892,920.35 → 7,892,920），逐行差 0.5 元以内是取整口径，不构成行11 的「小数点错误」；真正的错位差 3 个数量级，容差放宽不影响判否。合计行若恰好等于某一单行，视为抽取取错行，不据此判否。"
   },
   "optional_needs": [
    "bid.price_total_ex_tax"
   ],
   "evidence": "开标一览表 / 分项报价表",
   "human_gate": null,
   "external_source": null,
   "signals": null,
   "conclusion_ceiling": "CANDIDATE",
   "states": {
    "pass": "RESPONDED",
    "fail": "NOT_RESPONDED",
    "missing": "UNCERTAIN"
   }
  },
  {
   "rule_id": "GW-HB-FJ-012",
   "row": 12,
   "category": "响应性评审",
   "subcategory": "投标报价",
   "rule_text": "投标价格出现数值与货币单位不对应，即出现了明显的百倍至万倍高于正常水平的报价（如把“投标函价格表”中的“万元”当成“元”进行报价）。",
   "exec_path": "DET",
   "needs": [
    "bid.price_unit_ratio_to_ref"
   ],
   "check": {
    "op": "lt",
    "lhs": "bid.price_unit_ratio_to_ref",
    "rhs": 100
   },
   "evidence": "投标函价格表 / 同标包其他投标人报价",
   "human_gate": null,
   "external_source": null,
   "signals": null,
   "conclusion_ceiling": "CANDIDATE",
   "states": {
    "pass": "RESPONDED",
    "fail": "NOT_RESPONDED",
    "missing": "UNCERTAIN"
   }
  },
  {
   "rule_id": "GW-HB-FJ-013",
   "row": 13,
   "category": "响应性评审",
   "subcategory": "投标担保",
   "rule_text": "未按招标文件要求提交投标保证金的；以银行汇款形式提供的投标保证金未提供从投标人基本账户转出有效证明的（未提供有效证明是指未提供企业银行基本账户开户许可证复印件，也未提供投标人基本账户开户行通过账户管理系统打印的《基本存款账户信息》扫描件）；以投标保证保险形式提交的投标保证金，保单保费未从投标人基本账户转出或保单未体现保费是否由投标人基本账户支付的相关信息或未提供保单查询途径或提供的查询途径招标人无法查询的；以银行保函、投标保证保险形式提交的投标保证金不满足招标文件要求的（如对上述格式文件进行实质性修改或未按格式进行签署）。**（本批不适用）**",
   "exec_path": "EXTRACT_DET",
   "needs": [
    "bid.bond_amount",
    "tender.bond_required"
   ],
   "check": {
    "op": "and",
    "args": [
     {
      "op": "ge",
      "lhs": "bid.bond_amount",
      "rhs": "tender.bond_required"
     },
     {
      "op": "in",
      "lhs": "bid.bond_form",
      "rhs": [
       "bank_transfer",
       "bank_guarantee",
       "insurance",
       "letter"
      ]
     },
     {
      "op": "or",
      "args": [
       {
        "op": "ne",
        "lhs": "bid.bond_form",
        "rhs": "bank_transfer"
       },
       {
        "op": "eq",
        "lhs": "bid.bond_basic_account_proof",
        "rhs": true
       }
      ]
     }
    ]
   },
   "optional_needs": [
    "bid.bond_form",
    "bid.bond_basic_account_proof"
   ],
   "evidence": "投标保证金缴纳凭证 / 基本账户开户许可证 / 保函",
   "human_gate": null,
   "external_source": null,
   "signals": null,
   "conclusion_ceiling": "CANDIDATE",
   "states": {
    "pass": "RESPONDED",
    "fail": "NOT_RESPONDED",
    "missing": "UNCERTAIN"
   }
  },
  {
   "rule_id": "GW-HB-FJ-014",
   "row": 14,
   "category": "响应性评审",
   "subcategory": "投标范围",
   "rule_text": "投标范围与招标文件要求存在偏差的，且招标人不能接受的。",
   "exec_path": "HUMAN",
   "needs": [],
   "check": null,
   "evidence": "投标函 / 供货范围表 / 招标范围条款",
   "human_gate": "偏差是否可接受由招标人认定",
   "external_source": null,
   "signals": null,
   "conclusion_ceiling": "NEED_HUMAN",
   "states": {
    "always": "NEED_HUMAN"
   }
  },
  {
   "rule_id": "GW-HB-FJ-015",
   "row": 15,
   "category": "响应性评审",
   "subcategory": "投标偏差",
   "rule_text": "投标人提出招标人不能接受的条件或偏差的；未按要求填写具体数据信息以及填写的数据信息不满足招标文件规定的。",
   "exec_path": "HUMAN",
   "needs": [],
   "check": null,
   "evidence": "商务/技术偏差表",
   "human_gate": "由评标委员会逐条认定",
   "external_source": null,
   "signals": null,
   "conclusion_ceiling": "NEED_HUMAN",
   "states": {
    "always": "NEED_HUMAN"
   }
  },
  {
   "rule_id": "GW-HB-FJ-016",
   "row": 16,
   "category": "响应性评审",
   "subcategory": "投标期限",
   "rule_text": "投标有效期不满足招标文件要求的。",
   "exec_path": "DET",
   "needs": [
    "bid.validity_days",
    "tender.required_validity_days"
   ],
   "check": {
    "op": "ge",
    "lhs": "bid.validity_days",
    "rhs": "tender.required_validity_days"
   },
   "evidence": "投标函 / 招标文件投标人须知前附表",
   "human_gate": null,
   "external_source": null,
   "signals": null,
   "conclusion_ceiling": "CANDIDATE",
   "states": {
    "pass": "RESPONDED",
    "fail": "NOT_RESPONDED",
    "missing": "UNCERTAIN"
   }
  },
  {
   "rule_id": "GW-HB-FJ-017",
   "row": 17,
   "category": "响应性评审",
   "subcategory": "税率错误",
   "rule_text": "不按国家法律法规规定填报增值税税率或征收率的。",
   "exec_path": "DET",
   "needs": [
    "bid.tax_rate",
    "legal.tax_rate_set"
   ],
   "check": {
    "op": "in",
    "lhs": "bid.tax_rate",
    "rhs": "legal.tax_rate_set"
   },
   "evidence": "开标一览表 / 分项报价表 / 增值税税率栏",
   "human_gate": null,
   "external_source": null,
   "signals": null,
   "conclusion_ceiling": "CANDIDATE",
   "states": {
    "pass": "RESPONDED",
    "fail": "NOT_RESPONDED",
    "missing": "UNCERTAIN"
   }
  },
  {
   "rule_id": "GW-HB-FJ-018",
   "row": 18,
   "category": "资格评审",
   "subcategory": "法定否决",
   "rule_text": "投标文件响应与事实不符或虚假投标的（虚假投标包括但不限于投标人在其投标文件中提供虚假的资格证明文件、业绩证明文件、验收报告、故意修改招标文件明确列明的技术要求并对其进行响应等），该投标人参与本次投标的所有标包将均被否决，且该投标人在今后一段时间内参与国家电网有限公司及其所属单位招标活动的任何投标也将被否决。",
   "exec_path": "HUMAN",
   "needs": [
    "bid.performance_dates",
    "bid.invoice_numbers"
   ],
   "check": null,
   "evidence": "资格证明文件 / 业绩合同 / 验收报告 / 发票",
   "human_gate": "是否构成虚假投标由评标委员会认定并可追溯法律责任",
   "external_source": null,
   "signals": [
    "业绩合同签订日期晚于验收报告日期",
    "同一发票号在不同业绩中重复出现",
    "业绩金额与合同金额不一致"
   ],
   "conclusion_ceiling": "NEED_HUMAN",
   "states": {
    "always": "NEED_HUMAN"
   }
  },
  {
   "rule_id": "GW-HB-FJ-019",
   "row": 19,
   "category": "资格评审",
   "subcategory": "法定否决",
